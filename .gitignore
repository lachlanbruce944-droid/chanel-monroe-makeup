# Heavy media is served from Supabase Storage (bucket "media"); master copies live in M:\CMM-Site.
# src/ is written by tools/publish.py, which copies only what the site and its build need.
src/images/**/*.jpg
src/images/**/*.jpeg
src/images/**/*.webp
src/images/**/*.mp4
src/images/**/*.mov
!src/images/brands/**
!src/images/about/**
src/data/raw/
src/data/*-raw.json
src/images/icons/*.ttf

# Python and OS clutter
__pycache__/
*.pyc
.DS_Store
Thumbs.db
desktop.ini
